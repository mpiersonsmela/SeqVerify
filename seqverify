    new_gtf_sorted = f"seqverify_{output_name}.gtf"

    folder_insertion = f"{folder}/insertion"
    folder_cnv = f"{folder}/copy_number"
    folder_kraken = f"{folder}/kraken"
    folder_snp = f"{folder}/variant_calling"

